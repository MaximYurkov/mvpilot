{
  "openapi": "3.1.0",
  "info": {
    "title": "MVPilot API",
    "description": "Backend API for MVPilot",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health Check",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/cases": {
      "get": {
        "tags": [
          "cases"
        ],
        "summary": "Get Cases",
        "operationId": "listCases",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CaseRead"
                  },
                  "type": "array",
                  "title": "Response Listcases"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "cases"
        ],
        "summary": "Create Case",
        "operationId": "createCase",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CaseCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaseRead"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/cases/{case_id}": {
      "get": {
        "tags": [
          "cases"
        ],
        "summary": "Get Case",
        "operationId": "getCase",
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Case Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaseRead"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Case not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "cases"
        ],
        "summary": "Update Case",
        "operationId": "updateCase",
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Case Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CaseUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaseRead"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Case not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "cases"
        ],
        "summary": "Delete Case",
        "operationId": "deleteCase",
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Case Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Case not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/cases/{case_id}/analysis-runs": {
      "post": {
        "tags": [
          "analysis-runs"
        ],
        "summary": "Create Analysis Run",
        "operationId": "createAnalysisRun",
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Case Id"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisRunRead"
                }
              }
            }
          },
          "500": {
            "description": "Analysis failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Case not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "analysis-runs"
        ],
        "summary": "Get Case Analysis Runs",
        "operationId": "listCaseAnalysisRuns",
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Case Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AnalysisRunRead"
                  },
                  "title": "Response Listcaseanalysisruns"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Case not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/analysis-runs/{run_id}": {
      "get": {
        "tags": [
          "analysis-runs"
        ],
        "summary": "Get Analysis Run",
        "operationId": "getAnalysisRun",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisRunRead"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Analysis run not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "Root",
        "operationId": "getRoot",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnalysisReport": {
        "properties": {
          "summary": {
            "type": "string",
            "minLength": 1,
            "title": "Summary"
          },
          "analysis_plan": {
            "items": {
              "type": "string",
              "minLength": 1
            },
            "type": "array",
            "minItems": 1,
            "title": "Analysis Plan"
          },
          "assumptions": {
            "items": {
              "type": "string",
              "minLength": 1
            },
            "type": "array",
            "minItems": 1,
            "title": "Assumptions"
          },
          "problem": {
            "type": "string",
            "minLength": 1,
            "title": "Problem"
          },
          "target_audience": {
            "type": "string",
            "minLength": 1,
            "title": "Target Audience"
          },
          "audience_segments": {
            "items": {
              "$ref": "#/components/schemas/AudienceSegment"
            },
            "type": "array",
            "minItems": 1,
            "title": "Audience Segments"
          },
          "value_proposition": {
            "type": "string",
            "minLength": 1,
            "title": "Value Proposition"
          },
          "jtbd": {
            "items": {
              "$ref": "#/components/schemas/JTBDItem"
            },
            "type": "array",
            "minItems": 1,
            "title": "Jtbd"
          },
          "lean_canvas": {
            "$ref": "#/components/schemas/LeanCanvas"
          },
          "mvp": {
            "items": {
              "$ref": "#/components/schemas/MVPFeature"
            },
            "type": "array",
            "minItems": 1,
            "title": "Mvp"
          },
          "backlog": {
            "items": {
              "$ref": "#/components/schemas/BacklogItem"
            },
            "type": "array",
            "minItems": 1,
            "title": "Backlog"
          },
          "roadmap": {
            "items": {
              "$ref": "#/components/schemas/RoadmapStage"
            },
            "type": "array",
            "minItems": 1,
            "title": "Roadmap"
          },
          "risks": {
            "items": {
              "$ref": "#/components/schemas/ProductRisk"
            },
            "type": "array",
            "minItems": 1,
            "title": "Risks"
          },
          "critic_review": {
            "$ref": "#/components/schemas/CriticReview"
          },
          "recommendations": {
            "items": {
              "type": "string",
              "minLength": 1
            },
            "type": "array",
            "minItems": 1,
            "title": "Recommendations"
          },
          "final_report_markdown": {
            "type": "string",
            "minLength": 1,
            "title": "Final Report Markdown"
          }
        },
        "type": "object",
        "required": [
          "summary",
          "analysis_plan",
          "assumptions",
          "problem",
          "target_audience",
          "audience_segments",
          "value_proposition",
          "jtbd",
          "lean_canvas",
          "mvp",
          "backlog",
          "roadmap",
          "risks",
          "critic_review",
          "recommendations",
          "final_report_markdown"
        ],
        "title": "AnalysisReport"
      },
      "AnalysisRunRead": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "case_id": {
            "type": "integer",
            "title": "Case Id"
          },
          "status": {
            "$ref": "#/components/schemas/AnalysisStatus"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AnalysisReport"
              },
              {
                "type": "null"
              }
            ]
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Message"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "stages": {
            "items": {
              "$ref": "#/components/schemas/AnalysisStageRead"
            },
            "type": "array",
            "title": "Stages"
          }
        },
        "type": "object",
        "required": [
          "id",
          "case_id",
          "status",
          "result",
          "error_message",
          "started_at",
          "finished_at",
          "stages"
        ],
        "title": "AnalysisRunRead"
      },
      "AnalysisStageName": {
        "type": "string",
        "enum": [
          "planner",
          "market_analyst",
          "product_manager",
          "critic",
          "editor"
        ],
        "title": "AnalysisStageName"
      },
      "AnalysisStageRead": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "$ref": "#/components/schemas/AnalysisStageName"
          },
          "position": {
            "type": "integer",
            "title": "Position"
          },
          "status": {
            "$ref": "#/components/schemas/AnalysisStatus"
          },
          "result": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Message"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "position",
          "status",
          "result",
          "error_message",
          "started_at",
          "finished_at"
        ],
        "title": "AnalysisStageRead"
      },
      "AnalysisStatus": {
        "type": "string",
        "enum": [
          "pending",
          "running",
          "completed",
          "failed"
        ],
        "title": "AnalysisStatus"
      },
      "AudienceSegment": {
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "title": "Description"
          },
          "needs": {
            "items": {
              "type": "string",
              "minLength": 1
            },
            "type": "array",
            "minItems": 1,
            "title": "Needs"
          }
        },
        "type": "object",
        "required": [
          "name",
          "description",
          "needs"
        ],
        "title": "AudienceSegment"
      },
      "BacklogItem": {
        "properties": {
          "epic": {
            "type": "string",
            "minLength": 1,
            "title": "Epic"
          },
          "user_story": {
            "type": "string",
            "minLength": 1,
            "title": "User Story"
          },
          "acceptance_criteria": {
            "items": {
              "type": "string",
              "minLength": 1
            },
            "type": "array",
            "minItems": 1,
            "title": "Acceptance Criteria"
          },
          "priority": {
            "$ref": "#/components/schemas/BacklogPriority"
          }
        },
        "type": "object",
        "required": [
          "epic",
          "user_story",
          "acceptance_criteria",
          "priority"
        ],
        "title": "BacklogItem"
      },
      "BacklogPriority": {
        "type": "string",
        "enum": [
          "must",
          "should",
          "could"
        ],
        "title": "BacklogPriority"
      },
      "CaseCreate": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Title"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "title": "Description"
          },
          "audience": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Audience"
          },
          "problem": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Problem"
          },
          "stage": {
            "$ref": "#/components/schemas/CaseStage",
            "default": "idea"
          },
          "analysis_goal": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Analysis Goal"
          }
        },
        "type": "object",
        "required": [
          "title",
          "description"
        ],
        "title": "CaseCreate"
      },
      "CaseRead": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "audience": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Audience"
          },
          "problem": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Problem"
          },
          "stage": {
            "$ref": "#/components/schemas/CaseStage"
          },
          "analysis_goal": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Analysis Goal"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "description",
          "audience",
          "problem",
          "stage",
          "analysis_goal",
          "created_at",
          "updated_at"
        ],
        "title": "CaseRead"
      },
      "CaseStage": {
        "type": "string",
        "enum": [
          "idea",
          "validation",
          "prototype",
          "mvp",
          "launched"
        ],
        "title": "CaseStage"
      },
      "CaseUpdate": {
        "properties": {
          "title": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 255,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "audience": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Audience"
          },
          "problem": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Problem"
          },
          "stage": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CaseStage"
              },
              {
                "type": "null"
              }
            ]
          },
          "analysis_goal": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Analysis Goal"
          }
        },
        "type": "object",
        "title": "CaseUpdate"
      },
      "CriticReview": {
        "properties": {
          "issues": {
            "items": {
              "type": "string",
              "minLength": 1
            },
            "type": "array",
            "title": "Issues"
          },
          "contradictions": {
            "items": {
              "type": "string",
              "minLength": 1
